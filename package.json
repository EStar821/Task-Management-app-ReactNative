{
  "name": "task-management-app-reactnative",
  "version": "1.0.0",
  "description": "A modern task management app built with React Native and Expo",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "expo build:android",
    "build:ios": "expo build:ios",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=\"(taskUtils|integration)\"",
    "test:unit:coverage": "jest --testPathPattern=\"(taskUtils|integration)\" --coverage",
    "test:components": "jest --config jest.component.config.js",
    "test:all": "npm run test && npm run test:components"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~54.0.10",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest-expo": "^54.0.12",
    "typescript": "~5.9.2"
  },
  "private": true
}
